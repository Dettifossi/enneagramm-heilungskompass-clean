{
  "functions": {
    "api/stripe-webhook.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter-draft",
      "schedule": "0 7 28 * *"
    }
  ]
}
